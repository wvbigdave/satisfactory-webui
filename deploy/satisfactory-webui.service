[Unit]
Description=Satisfactory LAN management WebUI
After=network-online.target satisfactory.service
Wants=network-online.target

[Service]
Type=simple
User=satisfactory
Group=satisfactory
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/satisfactory-webui
ExecStart=/usr/bin/python3 -m satisfactory_webui.app
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SATISFACTORY_BIND=192.168.4.60
Environment=SATISFACTORY_PORT=8082
Environment=SATISFACTORY_HOSTS=192.168.4.60:8082,127.0.0.1:8082,localhost:8082,satisfactory:8082
Environment=SATISFACTORY_NETWORKS=192.168.4.0/22,127.0.0.0/8
Restart=on-failure
RestartSec=3
UMask=0077
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/satisfactory/server/FactoryGame/Saved/Config/LinuxServer
ReadOnlyPaths=/home/satisfactory/server
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
RestrictRealtime=true
MemoryMax=256M
TasksMax=64
# NoNewPrivileges cannot be enabled: fixed sudo systemctl commands use setuid.

[Install]
WantedBy=multi-user.target

# Template rendered by install.py; do not install this file directly.
[Unit]
Description=Satisfactory management WebUI
After=network-online.target @SERVICE@
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
SupplementaryGroups=systemd-journal
WorkingDirectory=@WORKING_DIR@
ExecStart=/usr/bin/python3 -m satisfactory_webui.app
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/satisfactory-webui/webui.env
EnvironmentFile=-/etc/satisfactory-webui/secrets.env
Restart=on-failure
RestartSec=3
UMask=0077
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=@CODE_DIR@
BindReadOnlyPaths=@SERVER_DIR@
BindReadOnlyPaths=@SAVE_DIR@
StateDirectory=satisfactory-webui
StateDirectoryMode=0700
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
RestrictRealtime=true
MemoryMax=256M
TasksMax=64
# NoNewPrivileges cannot be enabled: fixed sudo commands use setuid.

[Install]
WantedBy=multi-user.target
